# Aunak Core — environment template (copy to .env.local — never commit secrets)

# ── LIVE SETUP (real end-to-end — not MOCK) ───────────────
# 1. cp .env.example .env.local  →  set AIRTABLE_API_KEY=pat…
# 2. Ensure src/lib/airtable.js → MOCK_DATA_MODE = false
# 3. npm run live:ready          →  probe base + missing fields
# 4. npm run schema:students:apply → bootstrap Students columns
# 5. npm run live:seed           → seed Access Control tokens + demo rows
# 6. npm run dev                 → login with access_token from Airtable (NOT MOCK-*)

# ── Client (Vite) ─────────────────────────────────────────
# P0: production builds always use proxy — do NOT set PAT in Vercel client env
VITE_USE_AIRTABLE_PROXY=true
# Central multi-center base (live). Legacy archive: appaGfKj4vYhMw0cb
VITE_AIRTABLE_BASE_ID=appcjitgWsbvIebwf
VITE_AIRTABLE_STUDENTS_TABLE_ID=tblTidBPaVM4cf3O9
VITE_AIRTABLE_DAILY_SESSIONS_TABLE_ID=tblnNGiaKccMSpizT

# Dev-only direct Airtable (local .env.local — never in production Vercel)
# Create a Personal Access Token at https://airtable.com/create/tokens
# Scopes: data.records:read/write · schema.bases:read (write if bootstrapping)
# VITE_AIRTABLE_PAT=pat...

# Ghost Mirror Realtime (Ably) — server key required for publish; optional for local child subscribe tests
# ABLY_API_KEY=appId.keyId:secret

# B2G ministry anonymization HMAC salt (server-only — required for UDI CHD-XXXX)
# B2G_HMAC_SALT=your-sovereign-salt

# Dev-only master bypass override (disabled automatically in production builds)
# VITE_AUNAK_MASTER_KEY=

# Tawasul sandbox — NEVER set on sovereign production (aunak.vercel.app opens Core at /)
# Use /tawasul path instead. Only enable on Tawasul preview deployments.
# VITE_TAWASUL_MVP=true

# ── Server (Vercel — no VITE_ prefix) ───────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appcjitgWsbvIebwf
AIRTABLE_STUDENTS_TABLE_ID=tblTidBPaVM4cf3O9
ABLY_API_KEY=
B2G_HMAC_SALT=
TAP_SECRET_KEY=
ELEVENLABS_API_KEY=
